{
  "$comment": "Single machine-readable contract for runtime environment variables (R-09). Every key declared in .env.example or either platform manifest MUST appear here; unknown, duplicate or public-secret keys fail CI. Values never live in this file.",
  "variables": [
    {
      "key": "OPENAI_API_KEY",
      "secret": true,
      "required": true,
      "platforms": ["vercel"],
      "consumers": ["packages/agent/src/llm.ts", "scripts/eval-gate.mts"],
      "source": "secret:OPENAI_API_KEY"
    },
    {
      "key": "OPENAI_BASE_URL",
      "secret": false,
      "required": true,
      "platforms": ["vercel"],
      "consumers": ["packages/agent/src/llm.ts"],
      "source": "variable:OPENAI_BASE_URL"
    },
    {
      "key": "TRIAGE_MODEL",
      "secret": false,
      "required": true,
      "platforms": ["vercel"],
      "consumers": ["packages/agent/src/llm.ts"],
      "source": "variable:TRIAGE_MODEL"
    },
    {
      "key": "JEV_API_KEY",
      "secret": true,
      "required": false,
      "platforms": ["vercel"],
      "consumers": ["packages/agent/src/jev.ts"],
      "source": "secret:JEV_API_KEY"
    },
    {
      "key": "JEV_BASE_URL",
      "secret": false,
      "required": false,
      "platforms": ["local"],
      "consumers": ["packages/agent/src/jev.ts"],
      "source": "default:https://jev-ai.pro/api"
    },
    {
      "key": "JEV_MODEL",
      "secret": false,
      "required": false,
