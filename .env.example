# Local env (copy to .env.local; never commit secrets)
# --- LLM (absent => agent uses mock client, pipeline still fully runnable) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
TRIAGE_MODEL=ark-code-latest
# --- jev-ai System One (typed questions: noul/choice/score; absent => jev disabled) ---
JEV_API_KEY=
JEV_BASE_URL=https://jev-ai.pro/api
JEV_MODEL=jev-latest
# --- Build identity (injected by CI/Vercel; set for local dev if needed) ---
GIT_SHA=dev
GIT_BRANCH=local
APP_VERSION=0.1.0

# --- Supabase (Auth + DB) ---
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable>
NEXT_PUBLIC_GITHUB_OAUTH=0

# --- Control-plane DB (session pooler). Absent => console shows "DB unavailable".
# SUPABASE_DB_URL is accepted as an alias (CI uses that name). ---
PG_DSN=postgresql://postgres.<ref>:<password>@<host>:5432/postgres

# --- Eval worker (BFF wakes it after enqueue; cron is the backstop) ---
# SUT_BASE_URL: defaults to this deployment's own production URL
# WORKER_URL: e.g. https://eval-worker.onrender.com
# EVAL_WORKER_TOKEN: must equal the worker's WORKER_TOKEN
SUT_BASE_URL=
WORKER_URL=
EVAL_WORKER_TOKEN=

# --- Webhooks (secure-by-default once set; unset = disabled/refused) ---
# TRIAGE_TOKEN: /api/triage requires Bearer when set (auto-triage sends it)
# CORRECTION_SECRET: /api/corrections refuses all calls when unset
TRIAGE_TOKEN=
CORRECTION_SECRET=
CORRECTION_DATASET=triage-zh-v1
